<?xml version="1.0" encoding="UTF-8"?>
<!--
  Alternativa ao systemd, caso o systemd de usuario nao esteja disponivel no WSL.
  Registrar UMA VEZ, no PowerShell como administrador:

    Register-ScheduledTask -TaskName "TrackNews Bridge" -Xml (Get-Content -Raw -Path .\tracknews-bridge-task.xml)

  O nome "TrackNews Bridge" e novo de proposito: nenhuma tarefa existente e tocada.
  Desligar depois:  Disable-ScheduledTask -TaskName "TrackNews Bridge"
  Religar:          Enable-ScheduledTask  -TaskName "TrackNews Bridge"
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Entrega os alertas ja aprovados do TrackNews no grupo AutoPilot News, a cada 10 minutos, via WAHA local.</Description>
    <URI>\TrackNews Bridge</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <Repetition>
        <Interval>PT10M</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT5M</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>wsl.exe</Command>
      <Arguments>-d Ubuntu --exec /bin/bash -lc "python3 $HOME/tracknews-bridge/bridge.py run"</Arguments>
    </Exec>
  </Actions>
</Task>
