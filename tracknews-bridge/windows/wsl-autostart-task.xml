<?xml version="1.0"?>
<!-- Sem atributo encoding de proposito: o Register-ScheduledTask recebe este
     arquivo ja como string UTF-16 e recusa uma declaracao "UTF-8" com
     "O XML esta mal construido / nao e possivel alternar codificacao". -->
<!--
  Religa o WSL sozinho depois de reboot ou queda de luz.

  O timer systemd da ponte so roda enquanto o Ubuntu do WSL estiver de pe, e o
  Windows NAO sobe o WSL sozinho no boot. Esta tarefa fecha essa lacuna: no logon,
  ela inicia o Ubuntu e mantem um processo minimo vivo ("sleep infinity"), o que
  segura a VM do WSL ligada. Com systemd + linger ja configurados pelo install.sh,
  o timer volta sozinho e o Persistent=true recupera as execucoes perdidas.

  Registrar UMA VEZ, no PowerShell como administrador, na pasta deste arquivo:

    Register-ScheduledTask -TaskName "TrackNews WSL Autostart" -Xml (Get-Content -Raw -Path .\wsl-autostart-task.xml)

  O nome e novo de proposito: nenhuma tarefa existente e tocada.
  Desligar depois:  Disable-ScheduledTask -TaskName "TrackNews WSL Autostart"
  Religar:          Enable-ScheduledTask  -TaskName "TrackNews WSL Autostart"

  Para a cadeia funcionar sem ninguem na frente do PC, o Windows precisa logar o
  usuario sozinho (netplwiz > desmarcar "exigir nome e senha") e a energia precisa
  estar em "nunca suspender". Ver a secao "Queda de luz" do README.
-->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Sobe o Ubuntu do WSL no logon e o mantem vivo, para o timer da ponte TrackNews voltar sozinho depois de reboot ou queda de luz.</Description>
    <URI>\TrackNews WSL Autostart</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <Enabled>true</Enabled>
    <Hidden>true</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
    <RestartOnFailure>
      <Interval>PT1M</Interval>
      <Count>3</Count>
    </RestartOnFailure>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>wsl.exe</Command>
      <Arguments>-d Ubuntu --exec /bin/sh -c "sleep infinity"</Arguments>
    </Exec>
  </Actions>
</Task>
