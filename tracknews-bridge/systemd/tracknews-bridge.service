[Unit]
Description=Ponte TrackNews -> WhatsApp (grupo AutoPilot News)
Documentation=https://github.com/douglora/tracknews-autopilot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/tracknews-bridge
# 1. Auto-atualizacao: busca o branch, roda o autoteste da versao nova num
#    diretorio descartavel e so entao instala. "-" ignora qualquer falha.
ExecStartPre=-/usr/bin/bash %h/tracknews-bridge/atualizar.sh
# 2. Armar: sem destino gravado, procura o transporte (WAHA, depois o bridge do
#    Hermes) e o grupo; liga o envio; faz o teste unico autorizado uma vez so.
ExecStartPre=-/usr/bin/python3 %h/tracknews-bridge/bridge.py armar
# 3. Entrega respeitando os limites.
ExecStart=/usr/bin/python3 %h/tracknews-bridge/bridge.py run
# 4. Heartbeat sem segredos no branch tracknews-heartbeat, para acompanhar de fora.
ExecStartPost=-/usr/bin/bash %h/tracknews-bridge/heartbeat.sh
TimeoutStartSec=420
NoNewPrivileges=true
# A ponte so LE o repo de estado e USA o endpoint de envio ja existente (WAHA ou
# o bridge do Hermes). Ela nunca inicia, reinicia ou reconfigura nenhum dos dois,
# e nunca toca em autopilot-br nem em broadcast-terminal.
