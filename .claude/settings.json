{
  "enabledPlugins": {
    "financial-analysis@claude-for-financial-services": true,
    "equity-research@claude-for-financial-services": true,
    "market-researcher@claude-for-financial-services": true,
    "earnings-reviewer@claude-for-financial-services": true,
    "model-builder@claude-for-financial-services": true,
    "meeting-prep-agent@claude-for-financial-services": true,
    "claude-for-financial-advisors@claude-for-financial-advisors": true
  },
  "extraKnownMarketplaces": {
    "claude-for-financial-services": {
      "source": {
        "source": "github",
        "repo": "anthropics/financial-services"
      }
    },
    "claude-for-financial-advisors": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-for-financial-advisors"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/INSTALAR-PLUGINS-CLAUDE.command\" --quiet",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
