# Estado gerado em tempo de execucao pelo servidor
data/watchlist.json
data/alert_history.json
data/spread_history.json
*.pyc
__pycache__/

# Copia local do Chart.js, baixada na primeira execucao
vendor/

# Ambiente virtual criado pelo app.py quando o Python do sistema recusa instalar
.venv/

# Overrides pessoais do Claude Code (o settings.json compartilhado fica versionado)
.claude/settings.local.json

# Saida local do livro (testes e execucao offline)
livro_out/
.pytest_cache/

# Saida das analises de ETF (dado de mercado: nao versionar)
ferramentas/etf/saida/

# Coleta direta feita no computador do Douglas (ferramentas/local/coletar.py)
dados_local/

# roteiros de troca de conta: e-mails, ids de organizacao e decisoes internas (ficam so no Mac, nunca no repositorio publico)
PROMPT-PROXIMA-CONTA*.md
